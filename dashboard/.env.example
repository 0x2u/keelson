# A first install needs none of these: open the dashboard in the browser, enter the setup token from
# the container log, and choose the admin password. The master key is generated into master.key in
# the data directory. Set a variable below only for advanced hosting; a variable that is set always
# wins over what the setup stored.

# Master key: encrypts the agents' tokens and secrets at rest and signs sessions.
# Generate with: pnpm run generate-key
# KEELSON_DASHBOARD_KEY=

# The operator's password hash. Generate with: pnpm run hash-password
# KEELSON_ADMIN_PASSWORD_HASH=

# Where the SQLite database (and the generated master.key) lives (default ./data).
# KEELSON_DASHBOARD_DATA_DIR=./data

# Behind a reverse proxy that sets X-Forwarded-For: tell the login throttle
# to count failures per client instead of in one shared bucket.
# KEELSON_TRUST_PROXY=true

# Only for plain-http local use: the session cookie then drops its Secure flag.
# KEELSON_INSECURE_COOKIES=true

# The address the dashboard is served at. Passkeys are bound to its host name, so they are
# offered only when this is an https address (or http://localhost for development). The setup
# token line in the log names it too.
# KEELSON_PUBLIC_URL=https://keelson.example.com

# Refuse sessions that did not go through a second factor: a password-only session can only
# reach the page where one is set up.
# KEELSON_REQUIRE_2FA=true

# Only these addresses and ranges may reach the dashboard at all (comma separated).
# Needs KEELSON_TRUST_PROXY=true: the address comes from the reverse proxy's X-Forwarded-For.
# KEELSON_ALLOWED_IPS=203.0.113.7, 10.0.0.0/8

# The dashboard asks GitHub once a day which release is the latest, to show "Update available" in
# Settings. It sends a request to api.github.com (an IP address and a User-Agent naming the dashboard
# version) and nothing about your servers or projects. On by default; "off" makes no outbound call.
# KEELSON_UPDATE_CHECK=off

# Development and tests only: read the latest release from this address instead of GitHub's
# (a file served by any static server, in the shape of GitHub's releases/latest answer).
# KEELSON_UPDATE_CHECK_URL=http://127.0.0.1:8099/latest.json
