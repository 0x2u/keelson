{
  "name": "keelson-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for Keelson: a thin, token-scoped client of the dashboard API v1.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "keelson-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "check": "node src/index.ts --check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  }
}
